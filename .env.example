# Phase 2 CLI and server connection, kept empty until local PostgreSQL is set up.
# Shape: postgresql://USER:URL_ENCODED_PASSWORD@localhost:5432/wealth_portfolio
DATABASE_URL=

# Optional official Supabase CA file for verified TLS, relative to project root.
# Example path: .certs/supabase-ca.crt (download from your project dashboard).
# Vercel uses the same relative path (no @ alias or Windows absolute path).
# The public CA must be included in the deployment source/server bundle.
DATABASE_SSL_CA_FILE=

# Phase 3: random server secret (at least 32 characters); exact app origin.
# HTTP is allowed only for local loopback; use HTTPS for any remote environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Private demo seed password (12-128 characters). Never put it in browser code.
DEMO_ACCOUNT_PASSWORD=

# Phase 6: direct Google Gemini Developer API via Vercel AI SDK (no AI Gateway).
# Create a Gemini API key at https://aistudio.google.com/apikey and keep it private.
# Both entries are required to enable chat; no implicit model is selected.
# Set AI_MODEL to a tool/streaming-capable model available to your API project.
# Example model: gemini-3.5-flash-lite (availability/quota depend on your project).
# Missing configuration disables the assistant. Only use synthetic portfolio data.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=

# Keep these server-only. Never prefix secrets with NEXT_PUBLIC_.

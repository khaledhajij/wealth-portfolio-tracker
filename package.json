{
  "name": "wealth-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:inspect": "node --import tsx scripts/inspect-db.ts",
    "db:seed": "prisma generate && prisma db seed",
    "test": "prisma generate && node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:auth": "prisma generate && node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "test:api": "prisma generate && node --conditions=react-server --import tsx scripts/verify-api.ts",
    "test:ui": "prisma generate && node --conditions=react-server --import tsx scripts/verify-ui.ts",
    "auth:setup": "node --import tsx scripts/setup-auth.ts",
    "test:db": "prisma generate && node --conditions=react-server --import tsx scripts/verify-db.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/react": "4.0.157",
    "@better-auth/prisma-adapter": "1.7.12",
    "@next/env": "16.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.153",
    "better-auth": "1.7.12",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum AssetType {
  STOCK
  CRYPTO
  CASH
}

// Better Auth identity; existing domain IDs and memberships are preserved.
model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  emailVerified   Boolean            @default(false)
  image           String?
  sessions        Session[]
  accounts        Account[]
  pricedPositions Position[]         @relation("PriceActor")
  memberships     Membership[]
  movements       PositionMovement[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Portfolio {
  id          String       @id @default(cuid())
  name        String
  currency    String       @default("USD") @db.VarChar(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  positions   Position[]
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  portfolioId String
  role        MembershipRole
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  portfolio   Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, portfolioId])
  @@index([portfolioId])
}

model Position {
  id             String             @id @default(cuid())
  portfolioId    String
  assetType      AssetType
  label          String             @db.VarChar(160)
  symbol         String             @db.VarChar(32)
  unitPrice      Decimal            @db.Decimal(28, 8)
  priceAsOf      DateTime           @db.Timestamptz(3)
  priceUpdatedBy String?
  priceActor     User?              @relation("PriceActor", fields: [priceUpdatedBy], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  portfolio      Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements      PositionMovement[]

  @@unique([id, portfolioId])
  @@unique([portfolioId, assetType, symbol])
}

model PositionMovement {
  id             String   @id @default(cuid())
  portfolioId    String
  positionId     String
  signedQuantity Decimal  @db.Decimal(28, 10)
  createdBy      String
  occurredAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  requestKey     String   @unique @db.VarChar(128)
  note           String?  @db.VarChar(500)
  position       Position @relation(fields: [positionId, portfolioId], references: [id, portfolioId], onDelete: Restrict, onUpdate: Restrict)
  creator        User     @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([portfolioId, positionId, occurredAt])
  @@index([createdBy])
}
